# --- Django ---
SECRET_KEY="="
DEBUG=false
ALLOWED_HOSTS=*

# --- Database engine: postgres (default, used by Docker Compose) or sqlite (quick local dev) ---
DB_ENGINE=postgres
# SQLITE_PATH=/app/db.sqlite3   # only used when DB_ENGINE=sqlite

# --- PostgreSQL (used by both the db container and Django) ---
POSTGRES_DB=gov_service
POSTGRES_USER=gov
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (cache + rate limiting shared by all web replicas) ---
REDIS_URL=redis://redis:6379/1

# --- Rate limiting / business rules ---
RATE_LIMIT_AUTH_PER_MIN=50
RATE_LIMIT_API_PER_MIN=120
TRUST_X_FORWARDED_FOR=true
OFFICER_MAX_ACTIVE_TASKS=3
MAX_UPLOAD_MB=5

# --- Convenience ---
SEED_DEMO_DATA=true
HTTP_PORT=8080


#DEMO_PASSWORD="choose-a-private-demo-password"
WEB_WORKERS=2